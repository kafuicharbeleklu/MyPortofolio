# Local Vite development can use either VITE_GEMINI_API_KEY or GEMINI_API_KEY.
# VITE_GEMINI_API_KEY is the clearer browser-side option for .env.local.
VITE_GEMINI_API_KEY="AIzaSyBEu6NK_GQ2KHELmpBxWJ66B6SuKKKs_JI"

# Optional public base path for deployment. Default production value is /MyPortofolio/.
VITE_BASE_PATH="/MyPortofolio/"

# AI Studio compatibility fallback.
GEMINI_API_KEY="AIzaSyBEu6NK_GQ2KHELmpBxWJ66B6SuKKKs_JI"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
