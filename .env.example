# Local Vite development can use either VITE_GEMINI_API_KEY or GEMINI_API_KEY.
# Never commit a real API key here. Copy this file to .env.local and set your own value locally.
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Optional public base path for deployment. Default production value is /MyPortofolio/.
VITE_BASE_PATH="/MyPortofolio/"

# AI Studio compatibility fallback.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
