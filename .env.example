# Local Vite development can use either VITE_GEMINI_API_KEY or GEMINI_API_KEY.
# VITE_GEMINI_API_KEY is the clearer browser-side option for .env.local.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio compatibility fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
